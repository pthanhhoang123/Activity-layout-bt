
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#17232D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DEMO: CARDVIEW (CARD UI)"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:padding="12dp"
            android:background="#223442" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Giao diện Thẻ Nổi 3D trong Ứng Dụng"
            android:textColor="#EEEEEE"
            android:textSize="17sp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="18dp" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardStudent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#223442"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:contentPadding="20dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="THẺ SINH VIÊN HCMUTE"
                    android:textColor="#35B875"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Khoa Công Nghệ Thông Tin"
                    android:textColor="#BFC9D0"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvStudentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Họ và tên: Nguyễn Văn An"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvStudentInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="MSSV: 22110001 • Lớp: 22110CLA"
                    android:textColor="#BFC9D0"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/border_result"
                    android:padding="16dp"
                    android:text="KẾT QUẢ ĐẠT ĐƯỢC:\n\nXUẤT SẮC (Top 5% Khóa)"
                    android:textColor="#FFD83D"
                    android:textSize="20sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#298BC0"
            android:padding="12dp"
            android:text='app:cardElevation="8dp" (Đổ bóng 3D)'
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#27AE60"
            android:padding="12dp"
            android:text='app:cardCornerRadius="24dp" (Bo góc)'
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#E67E22"
            android:padding="12dp"
            android:text='app:contentPadding="20dp" (Đệm trong)'
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/border_code"
            android:padding="16dp"
            android:text=" // ĐIỀU KHIỂN TRONG KOTLIN ACTIVITY\n\nbinding.tvStudentName.text = student.name\n\nbinding.tvGpa.text = \"${student.gpa} / 4.0\"\n\n// Tùy biến CardView động\nbinding.cardStudent.radius = 32f\nbinding.cardStudent.cardElevation = 16f"
        android:textColor="#BFC9D0"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:lineSpacingExtra="5dp" />

    </LinearLayout>
</ScrollView>
